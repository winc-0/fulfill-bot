# 履约客服助手 环境变量模板
# 复制为 .env 后填写（Windows: copy .env.example .env）
#
# 只填 LLM_API_KEY 就能跑；不填也能跑——规划会自动回落到规则引擎，
# 只是理解"它呢""那这个能退吗"这类指代会明显变差。

# ---------- 模型（百炼 OpenAI 兼容端点） ----------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填入百炼 API Key
# 规划器每轮都调，用便宜的；写作用强的
LLM_PLANNER_MODEL=qwen-flash
LLM_WRITER_MODEL=qwen-plus
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

# ---------- 电商中台（模拟业务系统） ----------
COMMERCE_BASE_URL=http://127.0.0.1:18081
COMMERCE_TIMEOUT=8

# ---------- 对话状态 ----------
DIALOGUE_DB=data/dialogue.db
MAX_PAUSED_TASKS=3
# 低于该置信度不猜，直接澄清
CLARIFY_THRESHOLD=0.55
HISTORY_WINDOW=8

# ---------- 服务 ----------
SERVER_HOST=127.0.0.1
SERVER_PORT=18082
# 打开后 /api/chat 会返回本轮规划结果，便于调试
DEBUG=1
